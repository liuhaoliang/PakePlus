# 支付宝第三方纯 H5 —— 环境变量示例（提交到版本库，仅示例值，不放真实密钥）
# 站点公网地址：SEO canonical / og:url / sitemap 的 host（必填，上线前替换为你的域名）
NEXT_PUBLIC_SITE_URL=https://slingshot.example.com

# 仅「必须前端可见」的配置才用 NEXT_PUBLIC_*（见编码规范 §env 边界）。
# 服务端密钥（AppId 私钥 / 支付宝公钥）一律只放服务端 env，绝不入前端 bundle：
#   ALIPAY_APP_ID=
#   ALIPAY_APP_PRIVATE_KEY=
#   ALIPAY_PUBLIC_KEY=
#   ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do